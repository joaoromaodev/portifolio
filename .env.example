# Live-widget API credentials (server-only — never expose to the client).
# Each widget proxies through a Next.js Route Handler in /app/api/* (DESIGN.md §4/§11).
# Copy to .env.local and fill in. Widgets fall back to static snapshots when unset.

# Canonical site URL — used for metadata, sitemap.xml, robots.txt, the social
# card and the Person JSON-LD. Leave blank on Vercel: it falls back to the
# project's production domain, which already resolves to https://www.romaodev.com.
# Set it only to pin a host by hand — it is read at build time, so changing it
# needs a redeploy, and it must match whichever host is set to Production.
NEXT_PUBLIC_SITE_URL=

# GitHub — read-only token for the contributions/heatmap widget
GITHUB_TOKEN=

# Spotify — "now playing" (OAuth refresh-token flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steam — recently played (public profile)
STEAM_API_KEY=
STEAM_ID=

# Anthropic — "Ask my portfolio" chatbot (Claude Haiku 4.5, claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Cloudflare Turnstile — invisible anti-bot check on the chatbot (DESIGN.md §6.5).
# Free at dash.cloudflare.com → Turnstile. Optional: when unset, the check is
# skipped (the per-IP/global rate limits still apply). The site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: comma-separated extra origins allowed to call /api/ask. The site's
# own host is trusted automatically (same-origin), so this is only for letting
# a DIFFERENT origin in. e.g. https://example.com
ALLOWED_ORIGINS=

# Weather (Belém) uses Open-Meteo — no key required.
